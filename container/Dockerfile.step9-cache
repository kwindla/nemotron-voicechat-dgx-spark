ARG BASE_IMAGE=nemotron-local/voicechat-vllm:step9-instrument
FROM ${BASE_IMAGE}

ARG CACHE_ID
ARG CAPTURE_SIZES=
ARG ASSERT_CAPTURE_COVERAGE=0
ARG ASSERT_NO_POST_READY_COMPILE=0
ARG EXACT_PROMPT_WARMUP=0
COPY vllm-cache/ /root/.cache/vllm/
ENV VOICECHAT_STEP9_VALIDATE_BAKED_CACHE=1 \
    VOICECHAT_STEP9_BAKED_CACHE_KEY=${CACHE_ID} \
    VOICECHAT_STEP9_CAPTURE_SIZES=${CAPTURE_SIZES} \
    VOICECHAT_STEP9_ASSERT_CAPTURE_COVERAGE=${ASSERT_CAPTURE_COVERAGE} \
    VOICECHAT_STEP9_ASSERT_NO_POST_READY_COMPILE=${ASSERT_NO_POST_READY_COMPILE} \
    VOICECHAT_STEP9_EXACT_PROMPT_WARMUP=${EXACT_PROMPT_WARMUP}

LABEL ai.pipecat.voicechat.step9_cache="keyed immutable image-baked vLLM cache"
